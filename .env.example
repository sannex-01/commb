# ==============================================================================
# CommB Assistant Configuration
# All LLM providers, channels, payments, and storage are configured via the UI.
# ==============================================================================

APP_NAME="CommB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8422
APP_SECRET=""
# Public base URL of THIS instance. Used to build payment callback URLs and
# the webhook endpoints registered with Telegram/WhatsApp. Must be reachable
# from the internet for webhooks to work (use a tunnel in development).
COMMB_DOMAIN="http://localhost:8422"

# Database (defaults to SQLite at ./commb.db; set for PostgreSQL in production)
# DATABASE_URL="postgresql+asyncpg://commb_user:commb_secure_pass@localhost:5432/commb"

# Platform API key for programmatic access to this instance's API.
COMMB_API_KEY=""

# Update check (ON by default, no key or account needed). Fetches release notes
# and the sponsor banner over a plain public GET that sends only the running
# version — no personal data. Keeps security notices reaching this instance.
# Set to false for a fully offline install.
CHECK_FOR_UPDATES=true

# CommB Cloud sync (optional, OFF by default). THIS IS NOT ANONYMOUS TELEMETRY:
# when enabled, this instance sends customer profiles (name, email, phone),
# delivery addresses, orders, and full conversation transcripts to the CommB
# Cloud workspace behind the key below, which shows them in its Conversations
# CRM. Enabling it makes that workspace a data processor for your end users
# (NDPR / GDPR). A self-hosted CommB never phones home — leave this unset.
# Requires the extra: pip install commb[cloud]
ENABLE_CLOUD_SYNC=false
COMMB_CLOUD_KEY=""
COMMB_CLOUD_HOST=""

SYNC_INTERVAL_MINUTES=30
