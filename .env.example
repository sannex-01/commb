# ==============================================================================
# CommB Assistant Configuration
# All LLM providers, channels, payments, and storage are configured via the UI.
# ==============================================================================

APP_NAME="CommB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8422
APP_SECRET=""
# Public base URL of THIS instance. Used to build payment callback URLs and
# the webhook endpoints registered with Telegram/WhatsApp. Must be reachable
# from the internet for webhooks to work (use a tunnel in development).
COMMB_DOMAIN="http://localhost:8422"

# Database (defaults to SQLite at ./commb.db; set for PostgreSQL in production)
# DATABASE_URL="postgresql+asyncpg://commb_user:commb_secure_pass@localhost:5432/commb"

# Platform API key for programmatic access to this instance's API.
COMMB_API_KEY=""

# Telemetry (optional, OFF by default — a self-hosted instance never phones
# home). Only set these to report analytics to a collector such as Commb.app,
# and install the extra with: pip install commb[telemetry]
ENABLE_TELEMETRY=false
COMMB_TELEMETRY_KEY=""
COMMB_TELEMETRY_HOST=""
SYNC_INTERVAL_MINUTES=30
